# ==============================================================================
# PrimePrep CUET PG Examination Platform — Environment Variables (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development.
# Never commit real secret values to Git.

# ------------------------------------------------------------------------------
# 1. REQUIRED (Production & Render Single-Service Deployment)
# ------------------------------------------------------------------------------
NODE_ENV=production
NODE_VERSION=22
PGSSLMODE=require

# Supabase PostgreSQL Connection URI (Project Settings -> Database -> Connection String)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Backend HS256 JWT Signing Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_32_byte_random_hex_secret

# ------------------------------------------------------------------------------
# 2. OFFICIAL ADMINISTRATOR PROVISIONING (Prime Seven)
# ------------------------------------------------------------------------------
# Official Admin identity (provisioned idempotently on server startup)
ADMIN_NAME=Prime Seven
ADMIN_EMAIL=primeseven@gmail.com

# Set ADMIN_INITIAL_PASSWORD in Render/environment to seed the initial admin password
# (hashed with salted scrypt; never overwrites an existing admin password on restart)
ADMIN_INITIAL_PASSWORD=

# Optional one-time bootstrap secret for POST /api/v1/admin/bootstrap
ADMIN_SETUP_SECRET=

# ------------------------------------------------------------------------------
# 3. OPTIONAL (Razorpay Test Mode Payments & Cross-Origin Configuration)
# ------------------------------------------------------------------------------
# Required only when testing/using Razorpay payment checkout & webhook verification;
# application starts and operates normally if omitted.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Optional: Leave blank for single-service Render deployment (same-origin),
# or set to your Render URL (e.g. https://primeprep-cuetpg.onrender.com)
CORS_ORIGIN=

