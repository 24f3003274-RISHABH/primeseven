# ============================================================================
# PrimePrep — Environment Variables (.env.example)
# Contains ONLY variables actively read by the frontend or backend source code.
# Never commit real secret values to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. BACKEND RUNTIME & CORS (Render / Google AI Studio)
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="https://your-frontend-domain.vercel.app"

# ----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (Render / Supabase PostgreSQL)
# ----------------------------------------------------------------------------
# Primary connection string (Supabase Transaction/Session Pooler URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Standard libpq / node-pg SSL mode ("require" for Supabase / managed Postgres)
PGSSLMODE="require"

# Optional discrete PostgreSQL connection fallbacks (used only if DATABASE_URL is omitted)
PGHOST=""
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT VERIFICATION (Backend Only — Secret)
# ----------------------------------------------------------------------------
# Used to sign and verify PrimePrep HS256 session JWTs.
JWT_SECRET="replace_with_a_64_character_random_hex_secret"

# Optional: Set if verifying tokens minted directly by Supabase Auth.
# Can be omitted if using JWT_SECRET exclusively.
SUPABASE_JWT_SECRET=""

# ----------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY (Backend Only — Secret)
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="replace_with_your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_your_razorpay_webhook_secret"

# ----------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Vercel)
# ----------------------------------------------------------------------------
# Base URL of the Render backend API (no trailing slash).
# Leave empty ("") in Google AI Studio where frontend and backend share port 3000.
VITE_API_BASE_URL="https://your-backend-service.onrender.com"
