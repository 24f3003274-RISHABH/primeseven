{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student or administrator profile linked to Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full display name of the user.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "description": "Role assigned to the user.",
          "enum": ["student", "admin"]
        },
        "accountStatus": {
          "type": "string",
          "description": "Account activation status.",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["uid", "fullName", "email", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator lookup document keyed by UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "Student saved test or study note bookmark synchronized to Firestore.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "testId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "testId", "note", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores isolated user profile documents accessible only to the owner or an admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Stores administrator UIDs for role verification."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Stores student test notes and bookmarks scoped strictly to userId."
    }
  }
}
